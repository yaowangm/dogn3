# PostgreSQL connection string for the application database.
# For a PostgreSQL server running on the Docker host, keep host.docker.internal
# and replace DB_USER, DB_PASSWORD, and dogn with the real values.
DATABASE_URL=postgres://DB_USER:DB_PASSWORD@host.docker.internal:5432/dogn

# UID used when building the Docker image. Match the host image-directory owner
# so uploaded images stay writable after mounting the host path.
APP_UID=1000

# GID used when building the Docker image. Match the host image-directory group
# so uploaded images stay writable after mounting the host path.
APP_GID=1000

# HTTP bind address inside the container. Keep 0.0.0.0 for Docker port mapping.
BIND_ADDR=0.0.0.0:3000

# Maximum PostgreSQL connections kept in the application pool.
DATABASE_MAX_CONNECTIONS=5

# Site name displayed in page titles and headers.
SITE_NAME=Dogn

# Rust tracing filter for application and HTTP request logs.
RUST_LOG=dogn3=info,tower_http=info

# Number of root post trees displayed per board page.
BOARD_PAGE_SIZE=50

# Maximum age in days of a root post tree that still accepts replies.
POST_REPLY_MAX_AGE_DAYS=10

# Maximum points transferable when replying to a root post.
POST_REPLY_MAX_POINTS=100

# Initial points assigned to a newly created user.
NEW_USER_INITIAL_POINTS=100

# Points awarded for the first regular or announcement root post a user creates on each database date.
ROOT_POST_REGULAR_AWARD_POINTS=2

# Points awarded for the first forward root post a user creates on each database date.
ROOT_POST_FORWARD_AWARD_POINTS=5

# Points awarded for the first original root post a user creates on each database date.
ROOT_POST_ORIGINAL_AWARD_POINTS=10

# Maximum post subject length in characters.
POST_SUBJECT_MAX_LENGTH=50

# Maximum post content size in bytes.
POST_CONTENT_MAX_BYTES=131072

# Maximum post size in bytes that can be selected as a signature.
POST_SIGNATURE_MAX_BYTES=1000

# Directory inside the container that contains local post image files.
# The compose file maps ./data/images on the host to this path by default.
IMAGE_DIRECTORY=/app/images

# Maximum accepted uploaded image size in bytes before rejection.
IMAGE_UPLOAD_MAX_BYTES=2097152

# Enables optional Redis-backed portal/cache behavior.
CACHE_ENABLED=true

# Redis connection URL used by cache and production rate limiting.
REDIS_URL=redis://redis:6379

# Prefix applied to Redis keys created by this application.
REDIS_KEY_PREFIX=dogn3

# Default Redis cache TTL in seconds.
REDIS_DEFAULT_TTL_SECONDS=300

# Session cookie lifetime in seconds.
SESSION_TTL_SECONDS=604800

# Whether session cookies should be marked Secure; use true for HTTPS deployment.
SESSION_COOKIE_SECURE=false

# Maximum simultaneous password-hash computations.
LOGIN_MAX_CONCURRENT_HASHES=2

# Enables email-based password reset.
# Enable only after the host MTA accepts local SMTP requests.
PASSWORD_RESET_ENABLED=false

# Mail delivery backend for password reset emails: sendmail or smtp.
# Docker deployments use --network host, so smtp can reach the host MTA through localhost.
MAIL_DELIVERY=smtp

# Local sendmail-compatible command path, usually provided by Postfix.
# Used only when MAIL_DELIVERY=sendmail.
SENDMAIL_PATH=/usr/sbin/sendmail

# SMTP host used only when MAIL_DELIVERY=smtp.
SMTP_HOST=127.0.0.1

# SMTP port used only when MAIL_DELIVERY=smtp.
SMTP_PORT=25

# Sender address used for password reset emails; replace with a real domain address.
MAIL_FROM=no-reply@example.com

# Public base URL used to build password reset links.
PUBLIC_SITE_URL=https://example.com

# Password reset token lifetime in seconds.
PASSWORD_RESET_TTL_SECONDS=1800

# Enables retry limits for login and password reset endpoints.
RATE_LIMIT_ENABLED=true

# Rate-limit backend; use redis in production and memory only for development.
RATE_LIMIT_BACKEND=redis

# Failed-login counting window in seconds.
LOGIN_FAIL_WINDOW_SECONDS=900

# Failed-login limit per normalized user name in the counting window.
LOGIN_FAIL_MAX_PER_USER=5

# Failed-login limit per direct client IP in the counting window.
LOGIN_FAIL_MAX_PER_IP=30

# Failed-login lock duration in seconds after a limit is exceeded.
LOGIN_FAIL_LOCK_SECONDS=900

# Password-reset request counting window in seconds.
PASSWORD_RESET_WINDOW_SECONDS=3600

# Password-reset request limit per normalized email in the counting window.
PASSWORD_RESET_MAX_PER_EMAIL=3

# Password-reset request limit per direct client IP in the counting window.
PASSWORD_RESET_MAX_PER_IP=20

# Invalid reset-token confirmation counting window in seconds.
PASSWORD_RESET_CONFIRM_WINDOW_SECONDS=900

# Invalid reset-token confirmation limit per direct client IP in the counting window.
PASSWORD_RESET_CONFIRM_MAX_PER_IP=20
